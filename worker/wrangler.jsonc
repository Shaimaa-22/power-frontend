{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "power-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // Existing database: verify this ID in your account; do not create a replacement.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "power-db",
      "migrations_dir": "migrations",
      "database_id": "dc900d00-5f29-4ad0-a798-5dbc36904d11"
    }
  ],

  // Serves public/admin.html at /admin.html (same origin as the API => no CORS issues)
  "assets": { "directory": "./public" },

  // Cloudflare-managed counters, shared across isolates in each location (not a global quota).
  // Reserve this namespace ID for this application's authentication in your account.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "10051001", "simple": { "limit": 10, "period": 60 } }
  ],

  // Retry the D1 cleanup outbox, 10 images at a time. Same Worker; no Queues or new database.
  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // Where images live: "b2" (Backblaze, default — no card needed, existing images keep working)
    //                 or "r2" (Cloudflare R2 — needs a payment method on the Cloudflare account)
    "STORAGE_DRIVER": "b2",

    // Backblaze B2 (non-secret settings). Secrets B2_KEY_ID / B2_APPLICATION_KEY are set with `wrangler secret put`
    "B2_ENDPOINT": "s3.us-east-005.backblazeb2.com",
    "B2_REGION": "us-east-005",
    "B2_BUCKET_NAME": "power-images",

    // New/reset passwords only. Legacy hashes still verify with their stored work factor.
    // Workerd ceiling: 100000. Profile CPU on the intended plan; Free 10ms is NOT guaranteed.
    "PBKDF2_ITERATIONS": "100000"
  }

  // ---- To use R2 instead of B2: set STORAGE_DRIVER to "r2" above and uncomment this block ----
  // ,"r2_buckets": [{ "binding": "IMAGES", "bucket_name": "power-images" }]
}
